# Copia este archivo a .env.local y llena los valores desde tu proyecto de
# Firebase (console.firebase.google.com).

# --- Config del SDK de cliente (Project Settings → General → "Tus apps" → Web app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Credenciales de Firebase Admin (Project Settings → Cuentas de servicio →
# "Generar nueva clave privada", descarga el JSON y copia estos 3 valores) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Debe ir entre comillas y con los saltos de línea como "\n" literales,
# tal como aparecen en el JSON descargado.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

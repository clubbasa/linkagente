# Copia este archivo a .env.local y llena los valores desde tu proyecto de
# Firebase (console.firebase.google.com).

# --- Config del SDK de cliente (Project Settings → General → "Tus apps" → Web app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Credenciales de Firebase Admin (Project Settings → Cuentas de servicio →
# "Generar nueva clave privada", descarga el JSON y copia estos 3 valores) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Debe ir entre comillas y con los saltos de línea como "\n" literales,
# tal como aparecen en el JSON descargado.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Cobros con PayPal (developer.paypal.com → Apps & Credentials) ---
# "sandbox" mientras pruebas, "live" cuando ya cobres de verdad.
PAYPAL_ENV=sandbox
# Client ID de tu app — no es secreto, se usa también en el navegador.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Secret de tu app — este sí es secreto, solo se usa en el servidor.
PAYPAL_CLIENT_SECRET=
# Se obtiene una sola vez con scripts/setup-paypal-plan.mjs (ver README).
NEXT_PUBLIC_PAYPAL_PLAN_ID=
# Se obtiene al registrar el webhook en developer.paypal.com → tu app →
# Add Webhook, apuntando a https://tu-dominio/api/paypal/webhook.
PAYPAL_WEBHOOK_ID=
